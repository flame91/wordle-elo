# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
WORDLE_CHANNEL_ID=

# Wordle Activity application/bot ID.
# Activity ID from https://discord.com/activities/1211781489931452447 is 1211781489931452447,
# but the actual message author ID may differ. Confirm with scripts/fetch_sample.py on Day 1.
WORDLE_APP_ID=1211781489931452447

# Discord user to DM on failures (catch-up missed, parser errors)
ADMIN_USER_ID=

# Storage / time
TZ=Asia/Seoul
DB_PATH=/data/wordle.db
LOG_DIR=/data/logs

# ELO knobs (defaults match the design report)
INITIAL_ELO=1000          # starting ELO for every new player
K_FACTOR=24               # established-player K (FIDE master ≈ 16, general ≈ 24)
K_FACTOR_NEW=40           # new-player K applied for first NEW_PLAYER_GAMES games
NEW_PLAYER_GAMES=10       # placement window for K_FACTOR_NEW (FIDE uses 30)
DELTA_CLAMP=40            # max |delta| per day; safety net, rarely triggers at K=24
PLACEMENT_GAMES=14        # games before a player gets a real (non-Provisional) tier
SEASON_START_DATE=2025-10-22
