# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
WORDLE_CHANNEL_ID=

# Wordle Activity application/bot ID.
# Activity ID from https://discord.com/activities/1211781489931452447 is 1211781489931452447,
# but the actual message author ID may differ. Confirm with scripts/fetch_sample.py on Day 1.
WORDLE_APP_ID=1211781489931452447

# Discord user to DM on failures (catch-up missed, parser errors)
ADMIN_USER_ID=

# Storage / time
TZ=Asia/Seoul
DB_PATH=/data/wordle.db
LOG_DIR=/data/logs

# ELO knobs (defaults match the design report)
INITIAL_ELO=1000          # starting ELO for every new player
K_FACTOR=24               # established-player K (FIDE master ≈ 16, general ≈ 24)
K_FACTOR_NEW=40           # new-player K applied for first NEW_PLAYER_GAMES games
NEW_PLAYER_GAMES=10       # placement window for K_FACTOR_NEW (FIDE uses 30)
DELTA_CLAMP=40            # max |delta| per day; safety net, rarely triggers at K=24
PLACEMENT_GAMES=14        # games before a player gets a real (non-Provisional) tier
SEASON_START_DATE=2025-10-22

# Quarterly seasons (Q1 Jan-Mar / Q2 Apr-Jun / Q3 Jul-Sep / Q4 Oct-Dec).
# At each quarter boundary the finished season's standings are archived and
# announced, then every rating regresses toward INITIAL_ELO by SEASON_CARRY.
# SEASON_EPOCH is the first boundary the rollover acts on; puzzles before it
# seed the first tracked season without a reset.
SEASON_EPOCH=2026-01-01   # first season = 2026-Q1; first reset at 2026-04-01
SEASON_CARRY=0.0          # 0=hard reset to INITIAL (default), 1=no reset, 0.5=halfway

# Date-based fallback for puzzle number (Wordle Activity messages no longer embed it).
# Puzzle number = (message's local-date - 1day - WORDLE_EPOCH_DATE) in days.
# Default 2021-06-19 aligns with the common "Wordle #0 = June 19, 2021" convention.
WORDLE_EPOCH_DATE=2021-06-19
