# Storage / time
TZ=Asia/Seoul
DB_PATH=/data/wordle.db
LOG_DIR=/data/logs

# ELO knobs (defaults match the design report)
INITIAL_ELO=1000
K_FACTOR=24
PLACEMENT_GAMES=14
SEASON_START_DATE=2026-05-12
